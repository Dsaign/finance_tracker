# Copie este arquivo para .env e preencha com suas credenciais
# cp .env.example .env

# Formato: mysql+pymysql://usuario:senha@host:porta/nome_do_banco
# Exemplo local:
DATABASE_URL=mysql+pymysql://root:senha@localhost:3306/finance_tracker

# Ambiente da aplicação
APP_ENV=development  # development | production

# Chave secreta para JWT (gere com: openssl rand -hex 32)
SECRET_KEY=troque-por-uma-chave-segura

# CORS — origens permitidas (separadas por vírgula)
ALLOWED_ORIGINS=http://localhost:5173
