# =============================================================================
# Finance Tracker — .gitignore
# =============================================================================

# ── Ambiente e segredos ───────────────────────────────────────────────────────
.env
*.env
!.env.example

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# Ambientes virtuais
.venv/
venv/
env/
ENV/

# Distribuição / build
dist/
build/
*.egg-info/
*.egg
.eggs/

# pytest / coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# mypy / ruff / pyright
.mypy_cache/
.ruff_cache/
pyrightconfig.json

# ── Banco de dados ────────────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3

# ── Node / Frontend ───────────────────────────────────────────────────────────
node_modules/
frontend/dist/
frontend/build/
frontend/.vite/
*.tsbuildinfo

# ── IDEs e editores ───────────────────────────────────────────────────────────
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/

# ── Uploads temporários ───────────────────────────────────────────────────────
backend/uploads/
backend/tmp/
